# Google Maps Platform API key with Map Tiles API / Photorealistic 3D Tiles enabled.
# Copy this file to `.env` and paste your key. Never commit the real `.env`.
VITE_GOOGLE_MAPS_API_KEY=your-key-here

# A vector Map ID is required to render the 3D map. Create one in the Cloud console:
# Google Maps Platform > Map Management > Create Map ID > map type "JavaScript", with
# the "Photorealistic 3D Maps / Vector" option. Paste its ID here.
VITE_GOOGLE_MAPS_MAP_ID=your-map-id-here
